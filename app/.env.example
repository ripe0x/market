# Values only. Secrets (KEEPER_PRIVATE_KEY, OPENSEA_API_KEY) come from the host's secret store, never this file.

# Public, baked into the web build
NEXT_PUBLIC_MARKET_ADDRESS=
NEXT_PUBLIC_RPC_URL=https://mainnet.gateway.tenderly.co
NEXT_PUBLIC_EXPLORER=https://etherscan.io

# Server and keeper
RPC_URL=https://mainnet.gateway.tenderly.co
DB_PATH=/var/lib/market/market.db
START_BLOCK=            # Market deployment block, for the first sales sync
CONFIRMATIONS=3
PROFIT_MARGIN=1.25      # executor fee must cover expected gas cost times this
KEEPER_INTERVAL_MS=15000
STUCK_SECONDS=180
SUBMIT_RPC_URL=         # required for matching off a local fork: private relay, e.g. Flashbots Protect
